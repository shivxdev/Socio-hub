# Application Settings
APP_ENV=development
APP_NAME="NGO Community Solution API"
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Settings (Managed by Member 3)
DATABASE_URL=sqlite:///./data/ngo_community.db

# Authentication Settings (Firebase Admin SDK - Managed by Member 3)
# Firebase authentication is enforced by default.
# ENABLE_DEV_AUTH_OVERRIDE must only be enabled in isolated local testing, NEVER in production.
ENABLE_DEV_AUTH_OVERRIDE=False
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# AI Service Settings (Managed by Member 4 - Gemma/Gemini API)
# GEMINI_API_KEY: Your Google AI Studio or Vertex AI API key. Required for live AI analysis.
# GEMINI_MODEL_ID: The exact model identifier verified by Member 4.
#   Default: gemma-4-26b-a4b-it — verify availability in Google AI Studio before use.
#   Change to a supported model (e.g. gemini-1.5-flash) if the default is unavailable.
# GEMINI_TIMEOUT_SECONDS: HTTP timeout for AI API calls in seconds.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_SECONDS=30

# Assignment Rules (Shared / Member 3)
MAX_ACTIVE_TASKS=2
