# Backend Environment Variables Example
# Copy this file to backend/.env and replace placeholders with real credentials.
# NEVER commit .env to source control or expose backend keys to the frontend.

# Gemini API Configuration for Gemma 4
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_SECONDS=30.0

# Server & Database Settings (for reference across team)
PORT=8000
DATABASE_URL=sqlite:///./data/ngo_community.db
