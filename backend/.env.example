# Backend Environment Variables Example
# Copy this file to backend/.env and replace placeholders with real credentials.
# NEVER commit .env to source control or expose backend keys to the frontend.

# Gemini API Configuration for Gemma 4 (Member 4)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemma-4-26b-a4b-it
GEMINI_TIMEOUT_SECONDS=30.0

# Server & Database Settings (Member 3)
PORT=8000
APP_ENV=development
DATABASE_URL=sqlite:///./data/ngo_community.db
SQL_ECHO=false

# Firebase Authentication (Member 3)
# Path to service account JSON file, or provide FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=your-firebase-project-id

# Development Mock Auth (Member 3)
# Set to true ONLY for local automated testing without live Firebase credentials.
# Must be false in production environments.
ALLOW_DEV_MOCK_AUTH=false

# Assignment Configuration (Member 3)
# Maximum concurrent active tasks per volunteer (default 2)
MAX_ACTIVE_TASKS=2
