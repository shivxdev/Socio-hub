# Application Settings
APP_ENV=development
APP_NAME="NGO Community Solution API"
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Settings (Managed by Member 3)
DATABASE_URL=sqlite:///./data/ngo_community.db

# Authentication Settings (Firebase Admin SDK - Managed by Member 3)
# Firebase authentication is enforced by default.
# ENABLE_DEV_AUTH_OVERRIDE must only be enabled in isolated local testing, NEVER in production.
ENABLE_DEV_AUTH_OVERRIDE=False
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# AI Service Settings (Managed by Member 4)
# NOTE: Member 4 must verify the exact supported model ID under the Google Gemini API
# and whether multimodal image inputs are supported before enabling live AI calls.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
GEMINI_TIMEOUT_SECONDS=15

# Assignment Rules (Shared / Member 3)
MAX_ACTIVE_TASKS=2
